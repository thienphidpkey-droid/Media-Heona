{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "1" }], "destination": "/blog/checklist-to-chuc-su-kien", "permanent": true },
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "2" }], "destination": "/blog/chi-phi-to-chuc-hoi-nghi", "permanent": true },
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "3" }], "destination": "/blog/cach-chon-man-hinh-led", "permanent": true },
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "4" }], "destination": "/blog/quy-trinh-livestream-su-kien", "permanent": true },
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "5" }], "destination": "/blog/loi-thuong-gap-khi-tu-to-chuc-su-kien", "permanent": true },
    { "source": "/blog", "has": [{ "type": "query", "key": "id", "value": "6" }], "destination": "/blog/lam-viec-voi-agency-su-kien", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\""
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://images.unsplash.com https://lh3.googleusercontent.com https://i.ytimg.com https://*.ytimg.com https://img.youtube.com https://*.youtube.com; connect-src 'self' https://api.emailjs.com https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://*.googleapis.com; frame-src 'self' https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com; upgrade-insecure-requests;"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
